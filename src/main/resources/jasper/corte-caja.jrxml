<?xml version="1.0" encoding="UTF-8"?>
<!-- Corte de caja diario (REP-04, RPT.DR-1.1.0), formato del "CORTE DE CAJA" de COCAE. Carta vertical.
     Las filas llegan ya armadas desde CorteCajaReporteService con las cifras de CorteCajaService (RC-09):
     la plantilla no suma nada. Cada tipo de fila es una banda del detalle:
       SECCION  título del bloque y encabezados de sus dos columnas de importes
       RENGLON  concepto e importes
       TOTAL    concepto e importes en negritas, con línea arriba (y F/S en la diferencia)
       NOTA     texto aclaratorio
     Los importes son BigDecimal para que el Excel (misma plantilla) los tome como números.
     Sin cifras (antes del arranque o sin saldo de arranque) no hay filas: solo encabezado y aviso. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="corte-caja" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="556" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28">
	<property name="net.sf.jasperreports.awt.ignore.missing.font" value="true"/>
	<style name="Base" isDefault="true" fontName="Arial" fontSize="9"/>
	<style name="Seccion" mode="Opaque" backcolor="#E9ECEF" fontSize="9" isBold="true" pdfFontName="Helvetica-Bold">
		<box topPadding="2" leftPadding="3" bottomPadding="2" rightPadding="3">
			<bottomPen lineWidth="0.75"/>
		</box>
	</style>
	<style name="Celda">
		<box topPadding="2" leftPadding="3" bottomPadding="2" rightPadding="3">
			<bottomPen lineWidth="0.25" lineColor="#BBBBBB"/>
		</box>
	</style>
	<style name="Total" isBold="true" pdfFontName="Helvetica-Bold">
		<box topPadding="2" leftPadding="3" bottomPadding="2" rightPadding="3">
			<topPen lineWidth="0.75"/>
		</box>
	</style>
	<!-- Encabezado estándar (REP-00): subreporte y sus parámetros, ver EncabezadoReporte -->
	<parameter name="P_ENCABEZADO" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="P_EMPRESA" class="java.lang.String"/>
	<parameter name="P_RAZON_SOCIAL" class="java.lang.String"/>
	<parameter name="P_SUCURSAL" class="java.lang.String"/>
	<parameter name="P_TITULO" class="java.lang.String"/>
	<parameter name="P_FECHAS" class="java.lang.String"/>
	<parameter name="P_IMPRESO" class="java.lang.String"/>
	<parameter name="P_CODIGO_RPT" class="java.lang.String"/>
	<parameter name="P_FECHA_CORTE" class="java.lang.String"/>
	<!-- Solo cuando el corte no tiene cifras -->
	<parameter name="P_AVISO_TITULO" class="java.lang.String"/>
	<parameter name="P_AVISO" class="java.lang.String"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="concepto" class="java.lang.String"/>
	<field name="importe1" class="java.math.BigDecimal"/>
	<field name="importe2" class="java.math.BigDecimal"/>
	<field name="marca" class="java.lang.String"/>
	<field name="titulo1" class="java.lang.String"/>
	<field name="titulo2" class="java.lang.String"/>
	<title>
		<band height="70" splitType="Stretch">
			<subreport>
				<reportElement x="0" y="0" width="556" height="70"/>
				<parametersMapExpression><![CDATA[$P{REPORT_PARAMETERS_MAP}]]></parametersMapExpression>
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.JREmptyDataSource(1)]]></dataSourceExpression>
				<subreportExpression><![CDATA[$P{P_ENCABEZADO}]]></subreportExpression>
			</subreport>
		</band>
	</title>
	<detail>
		<band height="24" splitType="Prevent">
			<printWhenExpression><![CDATA["SECCION".equals($F{tipo})]]></printWhenExpression>
			<textField isBlankWhenNull="true">
				<reportElement style="Seccion" x="0" y="8" width="316" height="16"/>
				<textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Seccion" x="316" y="8" width="110" height="16"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{titulo1}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Seccion" x="426" y="8" width="110" height="16"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{titulo2}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement style="Seccion" x="536" y="8" width="20" height="16"/>
				<text><![CDATA[]]></text>
			</staticText>
		</band>
		<band height="15" splitType="Prevent">
			<printWhenExpression><![CDATA["RENGLON".equals($F{tipo})]]></printWhenExpression>
			<textField isBlankWhenNull="true">
				<reportElement style="Celda" x="0" y="0" width="316" height="15"/>
				<textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement style="Celda" x="316" y="0" width="110" height="15"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{importe1}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement style="Celda" x="426" y="0" width="110" height="15"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{importe2}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Celda" x="536" y="0" width="20" height="15"/>
				<textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression>
			</textField>
		</band>
		<band height="16" splitType="Prevent">
			<printWhenExpression><![CDATA["TOTAL".equals($F{tipo})]]></printWhenExpression>
			<textField isBlankWhenNull="true">
				<reportElement style="Total" x="0" y="0" width="316" height="16"/>
				<textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement style="Total" x="316" y="0" width="110" height="16"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{importe1}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement style="Total" x="426" y="0" width="110" height="16"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{importe2}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Total" x="536" y="0" width="20" height="16"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression>
			</textField>
		</band>
		<band height="13" splitType="Prevent">
			<printWhenExpression><![CDATA["NOTA".equals($F{tipo})]]></printWhenExpression>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="1" width="556" height="12" forecolor="#6C757D"/>
				<box leftPadding="3"/>
				<textElement><font size="7" isItalic="true" pdfFontName="Helvetica-Oblique"/></textElement>
				<textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="16" splitType="Stretch">
			<textField>
				<reportElement x="0" y="4" width="420" height="12"/>
				<textElement><font size="7"/></textElement>
				<textFieldExpression><![CDATA["Corte de caja - " + $P{P_FECHA_CORTE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="420" y="4" width="106" height="12"/>
				<textElement textAlignment="Right"><font size="7"/></textElement>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="526" y="4" width="30" height="12"/>
				<textElement><font size="7"/></textElement>
				<textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="52" splitType="Stretch">
			<printWhenExpression><![CDATA[$P{P_AVISO} != null]]></printWhenExpression>
			<textField isBlankWhenNull="true">
				<reportElement mode="Opaque" x="0" y="12" width="556" height="18" backcolor="#FFF8E6"/>
				<box topPadding="3" leftPadding="6" rightPadding="6">
					<topPen lineWidth="0.75" lineColor="#F0C36D"/>
					<leftPen lineWidth="3" lineColor="#F0C36D"/>
					<rightPen lineWidth="0.75" lineColor="#F0C36D"/>
				</box>
				<textElement><font size="10" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{P_AVISO_TITULO}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" mode="Opaque" x="0" y="30" width="556" height="20" backcolor="#FFF8E6"/>
				<box topPadding="2" leftPadding="6" bottomPadding="5" rightPadding="6">
					<leftPen lineWidth="3" lineColor="#F0C36D"/>
					<bottomPen lineWidth="0.75" lineColor="#F0C36D"/>
					<rightPen lineWidth="0.75" lineColor="#F0C36D"/>
				</box>
				<textFieldExpression><![CDATA[$P{P_AVISO}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Resultados del pase de almoneda: pestaña "Pase a venta" (C-11). Carta vertical. Mismas columnas
     que la pantalla y el CSV; el gerente lo usa para sacar las prendas de bóveda. Todos los campos
     llegan ya formateados como texto desde PaseAlmonedaReporteService. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pase-almoneda-pase-a-venta" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="556" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28">
	<property name="net.sf.jasperreports.awt.ignore.missing.font" value="true"/>
	<style name="Base" isDefault="true" fontName="Arial" fontSize="8"/>
	<style name="Encabezado" mode="Opaque" backcolor="#E9ECEF" fontSize="8" isBold="true" pdfFontName="Helvetica-Bold">
		<box topPadding="2" leftPadding="3" bottomPadding="2" rightPadding="3">
			<bottomPen lineWidth="0.75"/>
		</box>
	</style>
	<style name="Celda">
		<box topPadding="2" leftPadding="3" bottomPadding="2" rightPadding="3">
			<bottomPen lineWidth="0.25" lineColor="#BBBBBB"/>
		</box>
	</style>
	<parameter name="P_EMPRESA" class="java.lang.String"/>
	<parameter name="P_SUCURSAL" class="java.lang.String"/>
	<parameter name="P_FECHA_PASE" class="java.lang.String"/>
	<parameter name="P_IMPRESO" class="java.lang.String"/>
	<parameter name="P_TOTALES" class="java.lang.String"/>
	<parameter name="P_SIN_DATOS" class="java.lang.Boolean"/>
	<field name="contrato" class="java.lang.String"/>
	<field name="partida" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="fechaPase" class="java.lang.String"/>
	<title>
		<band height="70" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="556" height="16"/>
				<textElement textAlignment="Center"><font size="12" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{P_EMPRESA}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="16" width="556" height="11" isRemoveLineWhenBlank="true"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$P{P_SUCURSAL}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement positionType="Float" x="0" y="31" width="556" height="1"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>
			<staticText>
				<reportElement positionType="Float" x="0" y="35" width="556" height="15"/>
				<textElement textAlignment="Center"><font size="11" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<text><![CDATA[RESULTADOS DEL PASE DE ALMONEDA - PASE A VENTA]]></text>
			</staticText>
			<textField>
				<reportElement positionType="Float" x="0" y="52" width="278" height="12"/>
				<textElement><font size="9" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{P_FECHA_PASE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="278" y="52" width="278" height="12"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$P{P_IMPRESO}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="16" splitType="Stretch">
			<staticText>
				<reportElement style="Encabezado" x="0" y="0" width="90" height="16"/>
				<text><![CDATA[Contrato]]></text>
			</staticText>
			<staticText>
				<reportElement style="Encabezado" x="90" y="0" width="50" height="16"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Partida]]></text>
			</staticText>
			<staticText>
				<reportElement style="Encabezado" x="140" y="0" width="336" height="16"/>
				<text><![CDATA[Descripción]]></text>
			</staticText>
			<staticText>
				<reportElement style="Encabezado" x="476" y="0" width="80" height="16"/>
				<text><![CDATA[Fecha de pase]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="14" splitType="Prevent">
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="Celda" stretchType="ContainerHeight" x="0" y="0" width="90" height="14"/>
				<textFieldExpression><![CDATA[$F{contrato}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="Celda" stretchType="ContainerHeight" x="90" y="0" width="50" height="14"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$F{partida}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="Celda" stretchType="ContainerHeight" x="140" y="0" width="336" height="14"/>
				<textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement style="Celda" stretchType="ContainerHeight" x="476" y="0" width="80" height="14"/>
				<textFieldExpression><![CDATA[$F{fechaPase}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<pageFooter>
		<band height="16" splitType="Stretch">
			<textField>
				<reportElement x="0" y="4" width="420" height="12"/>
				<textElement><font size="7"/></textElement>
				<textFieldExpression><![CDATA["Pase de almoneda - Pase a venta - " + $P{P_FECHA_PASE}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="420" y="4" width="106" height="12"/>
				<textElement textAlignment="Right"><font size="7"/></textElement>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement x="526" y="4" width="30" height="12"/>
				<textElement><font size="7"/></textElement>
				<textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="36" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="4" width="556" height="14" forecolor="#6C757D" isRemoveLineWhenBlank="true">
					<printWhenExpression><![CDATA[$P{P_SIN_DATOS}]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Center"><font size="9"/></textElement>
				<text><![CDATA[Sin prendas pasadas a venta en esta fecha.]]></text>
			</staticText>
			<textField>
				<reportElement positionType="Float" x="0" y="20" width="556" height="14"/>
				<box topPadding="2" rightPadding="3"><topPen lineWidth="0.75"/></box>
				<textElement textAlignment="Right"><font size="9" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{P_TOTALES}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>

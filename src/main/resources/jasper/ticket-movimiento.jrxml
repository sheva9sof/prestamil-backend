<?xml version="1.0" encoding="UTF-8"?>
<!-- Nota de movimiento (RN-25): ticket de ~80 mm (227 pt). isIgnorePagination deja una sola página cuya
     altura crece con el contenido, como el papel de la impresora térmica. Los bloques de varias líneas
     llegan ya armados desde TicketMovimientoService; los renglones etiqueta/valor van en listas para que
     una etiqueta larga no desalinee los importes. -->

<?xml version="1.0" encoding="UTF-8"?>
<!-- Encabezado estándar de los reportes (REP-00): PRESTAMIL / razón social / sucursal / título /
     rango de fechas / fecha y hora de impresión / código RPT. Va como subreporte en el título de cada
     reporte; ReporteJasper lo escala al ancho de columna del reporte que lo usa, así que se diseña a
     556 (carta vertical) y sirve también para carta horizontal (736).
     Razón social y código RPT son opcionales: si llegan vacíos no ocupan lugar. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reporte-encabezado" pageWidth="556" pageHeight="200" whenNoDataType="AllSectionsNoDetail" columnWidth="556" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="net.sf.jasperreports.awt.ignore.missing.font" value="true"/>
	<style name="Base" isDefault="true" fontName="Arial" fontSize="8"/>
	<parameter name="P_EMPRESA" class="java.lang.String"/>
	<parameter name="P_RAZON_SOCIAL" class="java.lang.String"/>
	<parameter name="P_SUCURSAL" class="java.lang.String"/>
	<parameter name="P_TITULO" class="java.lang.String"/>
	<parameter name="P_FECHAS" class="java.lang.String"/>
	<parameter name="P_IMPRESO" class="java.lang.String"/>
	<parameter name="P_CODIGO_RPT" class="java.lang.String"/>
	<title>
		<band height="81" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="556" height="16"/>
				<textElement textAlignment="Center"><font size="12" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{P_EMPRESA}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="417" y="0" width="139" height="10">
					<printWhenExpression><![CDATA[$P{P_CODIGO_RPT} != null]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right"><font size="7"/></textElement>
				<textFieldExpression><![CDATA[$P{P_CODIGO_RPT}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="16" width="556" height="11" isRemoveLineWhenBlank="true"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$P{P_RAZON_SOCIAL}]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="27" width="556" height="11" isRemoveLineWhenBlank="true"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$P{P_SUCURSAL}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement positionType="Float" x="0" y="42" width="556" height="1"/>
				<graphicElement><pen lineWidth="0.5"/></graphicElement>
			</line>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="46" width="556" height="15"/>
				<textElement textAlignment="Center"><font size="11" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{P_TITULO}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement positionType="Float" x="0" y="63" width="278" height="12"/>
				<textElement><font size="9" isBold="true" pdfFontName="Helvetica-Bold"/></textElement>
				<textFieldExpression><![CDATA[$P{P_FECHAS}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement positionType="Float" x="278" y="63" width="278" height="12"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$P{P_IMPRESO}]]></textFieldExpression>
			</textField>
		</band>
	</title>
</jasperReport>
